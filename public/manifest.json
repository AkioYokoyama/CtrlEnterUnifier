{
  "manifest_version": 3,
  "name": "Ctrl+Enter Unifier",
  "version": "1.0.0",
  "description": "各種チャット/AIツールの送信キーをCtrl+Enterに統一します（Enterのみは改行）",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ctrl+Enter Unifier"
  }
}
